{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information stored at /users/{userId}",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "User role"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        }
      },
      "required": ["email", "role"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Journal entry document stored at /users/{userId}/entries/{entryId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique entry identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the journal reflection"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the entry is favorited"
        },
        "icon": {
          "type": "string",
          "description": "Optional emoji icon"
        },
        "font": {
          "type": "string",
          "enum": ["serif", "sans", "handwritten"],
          "description": "Font family preference"
        },
        "theme": {
          "type": "string",
          "enum": ["parchment", "sage", "slate", "dusk", "rose", "midnight"],
          "description": "Paper theme preference"
        },
        "mood": {
          "type": "string",
          "description": "Mood tag"
        },
        "summary": {
          "type": "string",
          "maxLength": 5000,
          "description": "AI generated synthesis summary"
        },
        "takeaways": {
          "type": "array",
          "description": "List of key takeaways"
        },
        "location": {
          "type": "object",
          "description": "Location metadata"
        },
        "messages": {
          "type": "array",
          "description": "Conversation / reflection stream messages"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Stores private user journal reflection entries"
    }
  }
}
