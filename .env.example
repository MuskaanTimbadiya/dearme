# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional API Key for Google Places Autocomplete API.
# If not provided, DearMe automatically falls back to OpenStreetMap Nominatim.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RATE LIMITING CONFIGURATION
# Authentication Endpoint Limits (Strict + Exponential Backoff)
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000          # 15 minutes window for auth requests per IP
RATE_LIMIT_AUTH_IP_MAX=10                     # Max auth requests per IP within the window
RATE_LIMIT_AUTH_ACCOUNT_MAX_ATTEMPTS=5        # Allowed attempts before exponential backoff
RATE_LIMIT_AUTH_INITIAL_BACKOFF_MS=2000      # 2 seconds initial backoff penalty
RATE_LIMIT_AUTH_MAX_BACKOFF_MS=60000          # 60 seconds maximum backoff penalty cap

# Public Endpoint Limits (Moderate)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000             # 1 minute window for public endpoints
RATE_LIMIT_PUBLIC_MAX=60                      # Max requests per IP within the window

# Authenticated User Action Limits (Looser)
RATE_LIMIT_AUTH_USER_WINDOW_MS=60000           # 1 minute window for logged in users
RATE_LIMIT_AUTH_USER_MAX=120                  # Max requests per authenticated UID within the window
